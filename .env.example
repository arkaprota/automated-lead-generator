# ==============================================================================
# LeadPilot AI SaaS - Master Environment Configuration Template
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=5000

# PostgreSQL Database (Neon Serverless with Row-Level Security)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/leadpilot?sslmode=require

# Redis Connection (Inbuilt Redis for Local / Render, or Upstash / Managed)
# For local / embedded single-container: redis://127.0.0.1:6379
# For external Upstash / Render managed: rediss://default:token@render-redis:6379
REDIS_URL=redis://127.0.0.1:6379

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Clerk Multi-Tenant Authentication
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# Frontend Client Public Variables
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Email Delivery Gateway (SMTP / Nylas)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_password
SMTP_FROM=outreach@yourdomain.com

# Cloud Storage (PDF Brochures - Cloudinary / Backblaze B2 / AWS S3)
STORAGE_BUCKET_NAME=leadpilot-brochures
STORAGE_ACCESS_KEY_ID=your_storage_key
STORAGE_SECRET_ACCESS_KEY=your_storage_secret
STORAGE_ENDPOINT=https://s3.us-east-005.backblazeb2.com
