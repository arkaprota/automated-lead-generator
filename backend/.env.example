# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Neon) Database Connection
DATABASE_URL=postgresql://neondb_owner:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Upstash Redis for BullMQ
REDIS_URL=redis://default:samplepassword@sample-redis.upstash.io:6379

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# Clerk Authentication (Backend secret key for verifying tokens / organizations)
CLERK_SECRET_KEY=sk_test_sample_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_sample_clerk_publishable_key

# Lead Scraping Provider API (Outscraper / SerpAPI)
SCRAPER_API_KEY=your_outscraper_or_serpapi_key

# Cloudinary / Backblaze B2 (Storage for generated PDF brochures)
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nylas / SMTP Dispatch & Webhook Secret
NYLAS_API_KEY=your_nylas_api_key
WEBHOOK_SECRET=your_webhook_signature_secret
